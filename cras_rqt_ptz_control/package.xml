<package format="3">
  <name>cras_rqt_ptz_control</name>
  <version>0.0.0</version>
  <description>An RQt plugin with a touch-friendly D-pad to control a PTZ gimbal-camera by relative motions and velocities.</description>
  <maintainer email="peckama2@fel.cvut.cz">Martin Pecka</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>cras_rqt_common</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
